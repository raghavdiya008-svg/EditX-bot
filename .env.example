# ==========================================
# EditX / Omni Discord Bot Environment Config
# ==========================================

# Discord Bot Credentials (Required)
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_application_client_id_here
GUILD_ID=your_primary_discord_guild_id_here

# Supreme Bot Owner Identity (Bypasses guild restrictions for admin commands)
BOT_OWNER_ID=your_discord_user_id_here

# Web Cockpit Dashboard & Health Check Server
PORT=3005
# Optional: Set secret token to protect sensitive dashboard control endpoints
DASHBOARD_SECRET=your_dashboard_secret_token_here

# AI & LLM Providers (Optional for AI Chat, Copilot, and AI Moderation)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=your_groq_api_key_here

# Social Alerts & Integrations (Twitch Live Stream Notifications)
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here

# Optional: External Cloud Database Connection (PostgreSQL / Supabase / MongoDB)
DATABASE_URL=
SUPABASE_URL=
MONGODB_URI=
